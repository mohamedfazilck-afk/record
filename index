<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Records Management</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- AUTHENTICATION SCREEN -->
    <div id="auth-screen" class="fixed inset-0 bg-slate-900 bg-opacity-75 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-8">
            <h2 class="text-2xl font-bold text-slate-900 mb-2 text-center">Teacher Portal</h2>
            <p class="text-sm text-slate-500 mb-6 text-center">Enter your passcode to access student records</p>
            <form id="login-form" onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Passcode</label>
                    <input type="password" id="passcode" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="••••">
                </div>
                <button type="submit" class="w-full bg-indigo-600 text-white font-medium py-2.5 rounded-lg hover:bg-indigo-700 transition">Login</button>
            </form>
        </div>
    </div>

    <!-- MAIN APP CONTAINER -->
    <div id="app-container" class="hidden flex-1 flex flex-col">
        <!-- Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
            <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
                <h1 class="text-lg font-bold text-indigo-600">Student Records Manager</h1>
                <div class="flex items-center space-x-3">
                    <button onclick="exportData()" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium px-3 py-1.5 rounded-lg transition">Backup Data</button>
                    <button onclick="logout()" class="text-xs bg-rose-50 hover:bg-rose-100 text-rose-600 font-medium px-3 py-1.5 rounded-lg transition">Logout</button>
                </div>
            </div>
            <!-- Navigation Tabs -->
            <nav class="flex overflow-x-auto px-4 space-x-6 border-t border-slate-100 bg-white text-sm font-medium text-slate-600">
                <button onclick="switchTab('dashboard')" class="tab-btn py-3 border-b-2 border-indigo-600 text-indigo-600 whitespace-nowrap">Dashboard</button>
                <button onclick="switchTab('students')" class="tab-btn py-3 border-b-2 border-transparent hover:text-slate-900 whitespace-nowrap">Students (28)</button>
                <button onclick="switchTab('analytics')" class="tab-btn py-3 border-b-2 border-transparent hover:text-slate-900 whitespace-nowrap">Analytics & Leaderboard</button>
            </nav>
        </header>

        <!-- Main Content Area -->
        <main class="flex-1 max-w-7xl w-full mx-auto p-4 md:p-6">
            
            <!-- TAB 1: DASHBOARD -->
            <section id="tab-dashboard" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                        <p class="text-xs font-medium text-slate-500 uppercase">Total Students</p>
                        <h3 class="text-2xl font-bold text-slate-900 mt-1">28</h3>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                        <p class="text-xs font-medium text-slate-500 uppercase">Active Practice Logs</p>
                        <h3 id="stat-logs" class="text-2xl font-bold text-indigo-600 mt-1">0</h3>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                        <p class="text-xs font-medium text-slate-500 uppercase">Adkar Mastery Avg</p>
                        <h3 id="stat-adkar" class="text-2xl font-bold text-emerald-600 mt-1">0%</h3>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                        <p class="text-xs font-medium text-slate-500 uppercase">Medical Flags</p>
                        <h3 id="stat-medical" class="text-2xl font-bold text-amber-600 mt-1">0</h3>
                    </div>
                </div>

                <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
                    <h3 class="text-base font-bold text-slate-900 mb-4">Quick Session Logging</h3>
                    <form onsubmit="handleQuickLog(event)" class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-slate-700 mb-1">Student</label>
                            <select id="quick-student-select" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500"></select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-700 mb-1">Activity Type</label>
                            <select id="quick-activity" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
                                <option value="Practice Session">Practice Session</option>
                                <option value="Adkar Memorization">Adkar Memorization</option>
                                <option value="Achievement">Achievement</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-700 mb-1">Score / Progress</label>
                            <input type="text" id="quick-score" placeholder="e.g. 95% or Completed" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
                        </div>
                        <div class="flex items-end">
                            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm py-2 rounded-lg transition">Save Record</button>
                        </div>
                    </form>
                </div>
            </section>

            <!-- TAB 2: STUDENTS DIRECTORY -->
            <section id="tab-students" class="hidden space-y-6">
                <div class="flex justify-between items-center">
                    <h2 class="text-xl font-bold text-slate-900">Student Rosters</h2>
                    <input type="text" id="search-student" oninput="filterStudents()" placeholder="Search student..." class="px-3 py-1.5 border border-slate-300 rounded-lg text-sm">
                </div>
                <div id="student-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    <!-- Dynamic Student Cards -->
                </div>
            </section>

            <!-- TAB 3: ANALYTICS & LEADERBOARD -->
            <section id="tab-analytics" class="hidden space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
                        <h3 class="text-base font-bold text-slate-900 mb-4">Top Performers Leaderboard</h3>
                        <div id="leaderboard-list" class="space-y-3">
                            <!-- Dynamic Leaderboard -->
                        </div>
                    </div>
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
                        <h3 class="text-base font-bold text-slate-900 mb-4">Master Roster Report</h3>
                        <p class="text-sm text-slate-500 mb-4">Export comprehensive master rosters or individual student performance reports instantly.</p>
                        <button onclick="exportMasterPDF()" class="bg-slate-900 hover:bg-slate-800 text-white font-medium text-sm px-4 py-2.5 rounded-lg transition">Download Master PDF Report</button>
                    </div>
                </div>
            </section>

        </main>
    </div>

    <!-- STUDENT DETAIL MODAL -->
    <div id="student-modal" class="hidden fixed inset-0 bg-slate-900 bg-opacity-75 flex items-center justify-center z-50 p-4 overflow-y-auto">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl max-h-[90vh] flex flex-col p-6">
            <div class="flex justify-between items-center pb-4 border-b border-slate-100">
                <h3 id="modal-student-name" class="text-lg font-bold text-slate-900">Student Details</h3>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
            </div>
            <div id="modal-body" class="flex-1 overflow-y-auto py-4 space-y-4">
                <!-- Detailed dynamic logs, adkar, medical history -->
            </div>
            <div class="pt-4 border-t border-slate-100 flex justify-end space-x-3">
                <button onclick="exportIndividualPDF()" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-medium text-xs px-3 py-2 rounded-lg transition">Export Student PDF</button>
                <button onclick="closeModal()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-medium text-xs px-4 py-2 rounded-lg transition">Close</button>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT APP LOGIC -->
    <script>
        // Mock data initialization for 28 students
        let students = JSON.parse(localStorage.getItem('sr_students')) || Array.from({length: 28}, (_, i) => ({
            id: i + 1,
            name: `Student ${i + 1}`,
            logs: [],
            adkarScore: Math.floor(Math.random() * 40) + 60,
            medicalNotes: i % 5 === 0 ? "Mild allergy to peanuts" : "None",
            achievements: ["Active Participant"]
        }));

        let activeStudentId = null;

        function handleLogin(e) {
            e.preventDefault();
            const pass = document.getElementById('passcode').value;
            if (pass === "1234" || pass.length > 0) { // simple passcode check
                document.getElementById('auth-screen').classList.add('hidden');
                document.getElementById('app-container').classList.remove('hidden');
                initApp();
            } else {
                alert('Invalid passcode');
            }
        }

        function logout() {
            document.getElementById('auth-screen').classList.remove('hidden');
            document.getElementById('app-container').classList.add('hidden');
        }

        function switchTab(tabName) {
            ['dashboard', 'students', 'analytics'].forEach(t => {
                document.getElementById(`tab-${t}`).classList.add('hidden');
            });
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('border-indigo-600', 'text-indigo-600');
                btn.classList.add('border-transparent', 'text-slate-600');
            });
            document.getElementById(`tab-${tabName}`).classList.remove('hidden');
            event.target.classList.add('border-indigo-600', 'text-indigo-600');
            event.target.classList.remove('border-transparent', 'text-slate-600');
        }

        function initApp() {
            updateStats();
            populateStudentDropdown();
            renderStudentsGrid();
            renderLeaderboard();
        }

        function updateStats() {
            let totalLogs = students.reduce((acc, s) => acc + s.logs.length, 0);
            let avgAdkar = Math.round(students.reduce((acc, s) => acc + s.adkarScore, 0) / students.length);
            let medicalCount = students.filter(s => s.medicalNotes !== "None").length;

            document.getElementById('stat-logs').innerText = totalLogs;
            document.getElementById('stat-adkar').innerText = avgAdkar + '%';
            document.getElementById('stat-medical').innerText = medicalCount;
            localStorage.setItem('sr_students', JSON.stringify(students));
        }

        function populateStudentDropdown() {
            const select = document.getElementById('quick-student-select');
            select.innerHTML = students.map(s => `<option value="${s.id}">${s.name}</option>`).join('');
        }

        function handleQuickLog(e) {
            e.preventDefault();
            const studentId = parseInt(document.getElementById('quick-student-select').value);
            const activity = document.getElementById('quick-activity').value;
            const score = document.getElementById('quick-score').value;

            const student = students.find(s => s.id === studentId);
            if (student) {
                student.logs.push({ date: new Date().toLocaleDateString(), activity, score });
                updateStats();
                document.getElementById('quick-score').value = '';
                alert('Record saved successfully!');
                renderStudentsGrid();
                renderLeaderboard();
            }
        }

        function renderStudentsGrid(filter = "") {
            const grid = document.getElementById('student-grid');
            const filtered = students.filter(s => s.name.toLowerCase().includes(filter.toLowerCase()));
            grid.innerHTML = filtered.map(s => `
                <div onclick="openStudentModal(${s.id})" class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-indigo-500 cursor-pointer transition">
                    <h4 class="font-bold text-slate-900">${s.name}</h4>
                    <p class="text-xs text-slate-500 mt-1">Adkar: ${s.adkarScore}%</p>
                    <p class="text-xs text-slate-500">Logs: ${s.logs.length}</p>
                    ${s.medicalNotes !== "None" ? '<span class="inline-block mt-2 bg-amber-50 text-amber-700 text-[10px] px-2 py-0.5 rounded font-medium">Medical Flag</span>' : ''}
                </div>
            `).join('');
        }

        function filterStudents() {
            const query = document.getElementById('search-student').value;
            renderStudentsGrid(query);
        }

        function openStudentModal(id) {
            activeStudentId = id;
            const student = students.find(s => s.id === id);
            document.getElementById('modal-student-name').innerText = student.name;
            
            let html = `
                <div class="space-y-3">
                    <div class="bg-slate-50 p-3 rounded-lg text-xs space-y-1">
                        <p><strong>Adkar Score:</strong> ${student.adkarScore}%</p>
                        <p><strong>Medical Notes:</strong> ${student.medicalNotes}</p>
                    </div>
                    <h4 class="font-bold text-sm text-slate-800">Activity & Practice Logs</h4>
            `;

            if (student.logs.length === 0) {
                html += `<p class="text-xs text-slate-400">No logs recorded yet.</p>`;
            } else {
                html += `<ul class="space-y-2">` + student.logs.map(l => `
                    <li class="bg-white border border-slate-100 p-2 rounded text-xs flex justify-between">
                        <span><strong>${l.activity}:</strong> ${l.score}</span>
                        <span class="text-slate-400">${l.date}</span>
                    </li>
                `).join('') + `</ul>`;
            }
            html += `</div>`;
            document.getElementById('modal-body').innerHTML = html;
            document.getElementById('student-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('student-modal').classList.add('hidden');
            activeStudentId = null;
        }

        function renderLeaderboard() {
            const list = document.getElementById('leaderboard-list');
            const sorted = [...students].sort((a, b) => b.adkarScore - a.adkarScore).slice(0, 5);
            list.innerHTML = sorted.map((s, idx) => `
                <div class="flex justify-between items-center text-sm p-2 bg-slate-50 rounded-lg">
                    <span class="font-medium text-slate-700">#${idx + 1} ${s.name}</span>
                    <span class="text-indigo-600 font-bold">${s.adkarScore}%</span>
                </div>
            `).join('');
        }

        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(students));
            const dlAnchorElem = document.createElement('a');
            dlAnchorElem.setAttribute("href", dataStr);
            dlAnchorElem.setAttribute("download", "student_records_backup.json");
            dlAnchorElem.click();
        }

        function exportMasterPDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();
            doc.text("Master Student Records Report", 14, 20);
            let y = 30;
            students.forEach((s, idx) => {
                doc.text(`${idx + 1}. ${s.name} - Adkar: ${s.adkarScore}% - Logs: ${s.logs.length}`, 14, y);
                y += 10;
                if (y > 280) { doc.addPage(); y = 20; }
            });
            doc.save("master_student_roster.pdf");
        }

        function exportIndividualPDF() {
            if (!activeStudentId) return;
            const student = students.find(s => s.id === activeStudentId);
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();
            doc.text(`Student Report: ${student.name}`, 14, 20);
            doc.text(`Adkar Score: ${student.adkarScore}%`, 14, 30);
            doc.text(`Medical Notes: ${student.medicalNotes}`, 14, 40);
            doc.text("Logs:", 14, 50);
            let y = 60;
            student.logs.forEach(l => {
                doc.text(`- ${l.date} | ${l.activity}: ${l.score}`, 18, y);
                y += 10;
            });
            doc.save(`${student.name}_report.pdf`);
        }
    </script>
</body>
</html>
